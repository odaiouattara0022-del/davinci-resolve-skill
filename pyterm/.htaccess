# ==========================================================================
# PyTerm — configuration Apache / LiteSpeed (Hostinger, cPanel, o2switch…)
#
# Deposez ce fichier a la racine du dossier qui contient index.html.
# Son role principal : envoyer les en-tetes d'isolation du site, que les
# hebergements statiques comme GitHub Pages ne permettent pas de definir.
# Ils debloquent SharedArrayBuffer, donc input() en direct et l'arret propre
# d'un programme, y compris sur iPhone.
# ==========================================================================

# ---------- HTTPS obligatoire (iOS n'installe que depuis une origine sure)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # ---------- Isolation du site
  # require-corp plutot que credentialless : Safari ne connait pas le second.
  # Les scripts externes sont charges en mode CORS (crossorigin="anonymous"),
  # ce qui satisfait require-corp. Apres tools/vendor_assets.py, il n'y a
  # plus aucune ressource externe du tout.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # ---------- Bonnes manieres
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # ---------- Cache
  # La coquille doit pouvoir etre mise a jour ; les dependances versionnees
  # peuvent etre gardees indefiniment.
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType text/javascript           "access plus 7 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType application/wasm          "access plus 1 year"
  ExpiresByType application/zip           "access plus 1 year"
</IfModule>

# ---------- Types MIME que les hebergements oublient souvent
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/wasm          .wasm
  AddType text/javascript           .js .mjs
  AddType image/svg+xml             .svg
  AddType application/json          .json
</IfModule>

# ---------- Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Le wasm et les zip sont deja compresses : ne pas y toucher.
</IfModule>

# ---------- Divers
Options -Indexes
DirectoryIndex index.html
<Files ".htaccess">
  Require all denied
</Files>
